generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // la usaremos desde Docker
}

model Listing {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Float
  createdAt   DateTime @default(now())
  userId      String
}


